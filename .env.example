# Copy this file to .env at the project root when setting up the real system.
# Use example values only in this file.
# Do not put real passwords, tokens, or secrets in this example file.

APP_NAME=BrakeCheck

# BrakeCheck uses APP_PORT for the web server port.
APP_PORT=3000

# Browser origins that are allowed to call the API.
# For home testing, add this computer's Wi-Fi/LAN IP.
# For company use, replace the example IP with the server PC IP.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.25:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=brakecheck_pg
# Use a dedicated PostgreSQL user for BrakeCheck_PG. Do not use postgres or another superuser in production.
DB_USER=brakecheck_app
DB_PASSWORD=replace_with_strong_postgresql_password

# Use a random text with at least 32 characters.
# Do not use this placeholder in the real .env file.
SESSION_SECRET=replace_with_random_text_at_least_32_chars
